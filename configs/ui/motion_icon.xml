
<window>
	<window rel_size="1.05" width="0" height="0" alignment="c"/>
	
	<!-- НОВЫЙ РЕЖИМ: Анимация альфа-канала для индикатора освещенности -->
	<!-- Круглая текстура с плавной пульсацией альфа-канала -->
	<!-- Цвет: красный-алый (r="255" g="0" b="0") -->
	<!-- По умолчанию скрыт (alpha_min="0.0"), появляется при обнаружении противника -->

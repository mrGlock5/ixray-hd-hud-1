	                     alignment="c" 
						 stretch="1"
	                     alpha_animation="1"
	                     alpha_speed="0.8"
	                     alpha_min="0.0"
	                     alpha_max="0.9"
	                     alpha_type="sine"
	                     r="255" g="91" b="91">
		<texture>ui_inGame2_Radar_green_bar</texture>
	</luminosity_progress>
	
	<!-- Старый режим секторов -->
